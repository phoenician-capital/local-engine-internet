# local-engine-internet
# Copy this file to .env and fill SERPAPI_KEY. That single key is enough to search.
#
#   cp .env.example .env
#   python -m engine
#   python scripts/check_search.py

ENGINE_HOST=0.0.0.0
ENGINE_PORT=8090
# Leave empty for local use (no auth). Set a shared secret if the port is on a network.
ENGINE_API_KEY=

# Search mix — every filled key is used in parallel. Best set: all three of the first.
# 1) SerpAPI (Google) — enough alone
SERPAPI_KEY=
# 2) Tavily — longer excerpts; same-URL hits keep Google as source + Tavily text
TAVILY_API_KEY=
# 3) Brave — independent index + news
BRAVE_API_KEY=
# Optional self-hosted
SEARXNG_URL=
# Pin-only official-site fallback. Leave blank unless Custom Search actually works.
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
TAVILY_SEARCH_DEPTH=advanced
SEARCH_PROVIDER_RETRIES=1

# Needed only for Mode 2 (the model decides to search). Search itself does not need a Brain.
UPSTREAM_LLM_BASE_URL=http://127.0.0.1:8080
UPSTREAM_API_KEY=
UPSTREAM_MODEL=deepseek-v4-flash

# no_browser is enough for search + static pages. Use full + `playwright install chromium` for JS IR sites.
FETCH_MODE=no_browser
MAX_TOOL_ROUNDS=6
MAX_SEARCH_USES=8
MAX_FETCHES=8
WEB_CONTEXT_BUDGET_CHARS=150000
MAX_CHARS_PER_DOC=8000
MAX_CHARS_PER_PDF=25000
DOC_FETCH_TIMEOUT=20
SEARCH_PROVIDER_TIMEOUT=15
REQUEST_TIMEOUT=300
HEADLESS_RENDER_TIMEOUT_MS=15000
SERPAPI_PACE_SECONDS=0.4
DEFAULT_WEB_POLICY=auto
DEFAULT_DOMAIN_MODE=general_research
# Layer 1 master switch. When false, no search/fetch; chat is a plain LLM pass-through.
# When true, Layer 2 (DEFAULT_WEB_POLICY=auto) lets the model decide per question.
PLUGIN_ENABLED=true
# Startup canary talks to ai-router. It runs in the background with a short timeout
# and never blocks search. Set false if you only want Mode 1.
RUN_CANARY_ON_STARTUP=true
CANARY_TIMEOUT_SECONDS=5

# SEC EDGAR requires a descriptive User-Agent with a contact.
SEC_EDGAR_USER_AGENT=Mozilla/5.0 (compatible; LocalEngineInternet/1.0; +https://phoeniciancapital.com)
